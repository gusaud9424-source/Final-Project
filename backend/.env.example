# ===== Flask =====
FLASK_ENV=development
SECRET_KEY=

# ===== MariaDB =====
DB_HOST=db
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ===== Redis (세션·캐시·rate limit) =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Gmail SMTP (이메일 인증) =====
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ===== Solapi (SMS 인증) =====
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# ===== 시연용 기본 계정 (seed.py) =====
# 로컬 시연 전용 값입니다. 외부에 공개하는 서버라면 반드시 바꾸거나 비워 두세요.
# 비워 두면 무작위 비밀번호를 만들어 seed 실행 시 콘솔에 한 번만 출력합니다.
SEED_ADMIN_PASSWORD=Admin1234
SEED_STUDENT_PASSWORD=Student1234
# student1 의 연락처 (아이디/비밀번호 찾기 실발송 테스트용, 비우면 가짜 주소 사용)
SEED_STUDENT_EMAIL=
SEED_STUDENT_PHONE=
